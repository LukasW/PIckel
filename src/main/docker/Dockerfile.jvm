# Container für PIkel im JVM-Modus.
#
#   ./mvnw package -DskipTests
#   docker build -f src/main/docker/Dockerfile.jvm -t pikel-jvm .
#   docker run --rm -p 8080:8080 \
#     -e QUARKUS_DATASOURCE_JDBC_URL=… -e QUARKUS_DATASOURCE_USERNAME=… -e QUARKUS_DATASOURCE_PASSWORD=… pikel-jvm
#
# JVM-Optionen über JAVA_TOOL_OPTIONS; die JVM liest die Variable selbst, ein Startskript ist nicht nötig.
# Die Plattform bestimmt `docker build --platform`, nicht das Dockerfile.
FROM eclipse-temurin:25.0.4_7-jre-noble

RUN groupadd -r appgroup --gid=185 && useradd -r -g appgroup --uid=185 appuser \
    && mkdir -p /deployments \
    && chown 185:185 /deployments

# Vier Schichten, damit bei Änderungen am Code die Bibliotheken aus dem Cache kommen
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-jar", "/deployments/quarkus-run.jar"]
