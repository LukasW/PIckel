{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(./mvnw:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(curl:*)",
      "Bash(rm:-rf .trees/*)",
      "Bash(rm:-rf target/*)",
      "Bash(rm:-rf src/main/webapp/node_modules)",
      "mcp__github__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_context7_context7__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reviewer-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "grudligstrasse": {
      "source": {
        "source": "git",
        "url": "https://scm.grudligstrasse.ch/Tools/claude-flow.git",
        "ref": "v0.6.0"
      }
    }
  },
  "enabledPlugins": {
    "flow@grudligstrasse": true
  }
}
