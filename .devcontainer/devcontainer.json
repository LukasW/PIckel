{
  "name": "PIckel",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.19.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/docker-outside-of-docker",
    "ghcr.io/devcontainers/features/github-cli",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers/features/java"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-quarkus",
        "Angular.ng-template",
        "esbenp.prettier-vscode",
        "anthropic.claude-code"
      ]
    }
  },
  "forwardPorts": [8080, 4200],
  "mounts": [
    "source=pickel-node-modules,target=${containerWorkspaceFolder}/src/main/webapp/node_modules,type=volume",
    // Quinoa lädt Node plattformabhängig nach .quinoa/node; das macOS-Binary vom Host läuft hier nicht
    "source=pickel-quinoa,target=${containerWorkspaceFolder}/.quinoa,type=volume",
    // Logins von Claude Code und gh überleben Neustart und Rebuild
    "source=pickel-claude-config,target=/home/vscode/.claude,type=volume",
    "source=pickel-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {
    "WORKSPACE": "${containerWorkspaceFolder}",
    // Damit auch .claude.json (Onboarding, Projekt-Vertrauen) im Volume liegt statt in ~
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Docker läuft ausserhalb des Containers: Ports, die Testcontainers für die Dev Services veröffentlicht,
    // liegen auf dem Host, nicht auf localhost. Ohne Override scheitern CucumberIT und SmokeIT mit
    // «Container startup failed for image postgres». host.docker.internal stellen Docker Desktop und Podman bereit
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  // Unter Podman hinterlässt das Java-Feature /tmp im Image mit 0755 statt 1777. Der VS-Code-Server
  // legt seine Sockets dort an, bevor ein Lifecycle-Hook ein chmod nachholen kann; darum ein tmpfs.
  // Das Java-Feature installiert zuletzt, damit apt in den übrigen Features noch ein intaktes /tmp hat.
  "runArgs": ["--tmpfs", "/tmp:rw,exec,nosuid,nodev,mode=1777"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
